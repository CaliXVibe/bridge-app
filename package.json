{
  "name": "bridge-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orchestrator that connects multiple AI platforms to one shared private GitHub workspace.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/*.test.ts tests/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
